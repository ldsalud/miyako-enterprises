# Miyako Enterprises — Environment Variables
# 
# Copy this file to .env.local and fill in the actual values
# NEVER commit .env or .env.local with real secrets to GitHub

# ── Resend Email Service ──
# Get your API key from: https://resend.com/api-keys
# This is used to send contact form emails via the /contact endpoint
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare Workers Configuration ──
# These are typically set in wrangler.toml, but can also be set here
# Environment name (development or production)
ENVIRONMENT=production

# ── Optional: Local Development ──
# For local testing with wrangler dev
DEBUG=false
